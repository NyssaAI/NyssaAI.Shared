{
  "name": "@nyssa-ai/logging",
  "version": "0.3.0",
  "description": "Lightweight operational logging destinations with rotating JSON files and clean protocol streams",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('./dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:usecase": "vitest run test/use_case",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NyssaAI/NyssaAI.Shared.git",
    "directory": "nyssa-ai-logging-ts"
  },
  "keywords": [
    "logging",
    "jsonl",
    "rotating",
    "stderr",
    "stdout",
    "structured-logging"
  ],
  "author": "NyssaAI",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "pino": "^10.4.0"
  }
}
