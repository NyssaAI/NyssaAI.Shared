{
  "name": "@nyssa-ai/db-gateway",
  "version": "0.1.0",
  "description": "Zero-ceremony, typed database gateway across SQLite and PostgreSQL matching NyssaAI.DbGateway",
  "type": "module",
  "main": "./dist/gateway/DbGatewayClient.js",
  "types": "./dist/gateway/DbGatewayClient.d.ts",
  "exports": {
    ".": {
      "import": "./dist/gateway/DbGatewayClient.js",
      "types": "./dist/gateway/DbGatewayClient.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('./dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:usecase": "vitest run test/use_case",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NyssaAI/NyssaAI.Shared.git",
    "directory": "nyssa-ai-dbgateway-ts"
  },
  "keywords": [
    "database",
    "sqlite",
    "postgres",
    "postgresql",
    "gateway",
    "migrations"
  ],
  "author": "NyssaAI",
  "license": "Apache-2.0",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.11.11",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild": true
  }
}
