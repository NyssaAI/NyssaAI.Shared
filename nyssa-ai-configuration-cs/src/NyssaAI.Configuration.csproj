<Project Sdk="Microsoft.NET.Sdk">

  <!-- Nullable, TreatWarningsAsErrors, GenerateDocumentationFile, ImplicitUsings, and LangVersion
       come from the repository-root Directory.Build.props (D10). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NyssaAI.Configuration</AssemblyName>
    <RootNamespace>NyssaAI.Configuration</RootNamespace>
    <ClientContractFile>IConfiguration.cs</ClientContractFile>
    <ExtensionContractFile>IConfigurationExtensions.cs</ExtensionContractFile>
    <Version>0.3.1</Version>
    <Authors>jamaynor</Authors>
    <Description>Manifest-based configuration, typed settings, local encryption, OAuth, and vault provider contracts.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/NyssaAI/NyssaAI.Shared/tree/main/NyssaAI.Configuration</PackageProjectUrl>
    <!-- Enables the trim, single-file, and AOT analyzers, matching NyssaAI.Result. With
         TreatWarningsAsErrors from Directory.Build.props, any AOT-incompatible API use fails the
         build. The JSON call sites use source-generated contexts; the two open-generic accessors on
         ConfigurationStore declare RequiresDynamicCode instead, because a caller-supplied type
         cannot be enumerated into a context at this project's compile time. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- LibraryImport (the AOT-safe P/Invoke generator) needs unsafe blocks for the native
         credential-store bindings in KeyringWindows and KeyringLinux. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NyssaAI.Configuration.Tests" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- The OAuth token-endpoint client comes from IHttpClientFactory when the host registered one,
         so a test can point it at a fake handler; otherwise a plain HttpClient. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../NyssaAI.Result/src/NyssaAI.Result.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
