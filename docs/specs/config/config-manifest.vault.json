{
  "version": 1,
  "applications": {
    "PaymentGatewayService": {
      "configurationDirectory": "/var/app/payments/config",
      "lockTimeoutMs": 15000,
      "keyVault": {
        "name": "paymentSecretsVault",
        "kind": "bitwarden-secrets",
        "endpoint": "https://vault.internal.net",
        "credential": "auth/bitwarden-grant",
        "settings": {
          "organizationId": "11111111-2222-3333-4444-555555555555",
          "apiUrl": "https://api.bitwarden.com"
        },
        "secrets": {
          "accessToken": "<bitwarden-machine-account-access-token>"
        }
      }
    },
    "CustomerPortalApp": {
      "configurationDirectory": "./config",
      "lockTimeoutMs": 8000,
      "keyVault": {
        "name": "azureVault",
        "kind": "azure-key-vault",
        "endpoint": "https://corp-kv.vault.azure.net",
        "credential": "auth/azure-oauth-token",
        "settings": {
          "tenantId": "77777777-8888-9999-aaaa-bbbbccccdddd"
        }
      }
    }
  }
}
