<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- xUnit v3 test projects are self-executing Microsoft.Testing.Platform hosts -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NyssaAI.Configuration.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- D10 opt-out: test types carry no public API contract, so XML docs are not required
         on them. Every other Directory.Build.props setting still applies. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- The manual OsKeyring suite reads the credential store through its own LibraryImport
         declarations rather than the adapter's, so the stored bytes are checked independently
         of the layout under test. LibraryImport generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\NyssaAI.Configuration.csproj" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
</Project>
