<Project Sdk="Microsoft.NET.Sdk">

  <!-- Nullable, TreatWarningsAsErrors, GenerateDocumentationFile, ImplicitUsings, and LangVersion
       come from the repository-root Directory.Build.props. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <AssemblyName>NyssaAI.Repository</AssemblyName>
    <RootNamespace>NyssaAI.Repository</RootNamespace>
    <ClientContractFile>IRepository.cs</ClientContractFile>
    <Version>0.2.0</Version>
    <Authors>jamaynor</Authors>
    <Description>Typed database commands, caller-owned sessions and transactions, and explicit schema migrations for SQLite and PostgreSQL.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/NyssaAI/NyssaAI.Shared/tree/main/NyssaAI.Repository</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../NyssaAI.Configuration/src/NyssaAI.Configuration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NyssaAI.Repository.Tests" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
