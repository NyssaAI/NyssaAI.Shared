# Ignore dot directories at every level (tracked files remain tracked).
.*/
!.github/
!.github/**
!.nyssa-ai/
!.nyssa-ai/dev-standards/
!.nyssa-ai/dev-standards/**
!.compound-engineering/
!.compound-engineering/config.yaml
!.compound-engineering/config.example.yaml

**/bin/
**/obj/
**/TestResults/
*.user
*.suo
*.nupkg
*.snupkg
.env
.env.*
!.env.example
**/secrets.json
**/config-manifest.json
!docs/specs/**/config-manifest.json

# Build, dependency, and test runner outputs
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
node_modules/
dist/

# Mandatory repository-local scratch directory (REPO-SCRATCH)
.temp/
.worktrees/
.compound-engineering/*.local.yaml
.context/compound-engineering/
