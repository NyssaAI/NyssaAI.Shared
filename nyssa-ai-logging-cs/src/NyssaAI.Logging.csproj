<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NyssaAI.Logging</AssemblyName>
    <RootNamespace>NyssaAI.Logging</RootNamespace>
    <SourceRootContractOptOut>Logging provider package; callers configure Microsoft logging and consume ILogger, and this package contributes one destination through an ILoggingBuilder extension rather than opening a client.</SourceRootContractOptOut>
    <Description>Rotating structured JSON file logging and standard-error setup for Microsoft.Extensions.Logging.</Description>
    <Version>0.2.2</Version>
    <Authors>jamaynor</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/NyssaAI/NyssaAI.Shared/tree/main/nyssa-ai-logging-cs</PackageProjectUrl>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NyssaAI.Logging.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
