<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NyssaAI.Result</AssemblyName>
    <RootNamespace>NyssaAI.Results</RootNamespace>
    <SourceRootContractOptOut>Passive result-model package; callers consume feature-owned result and error types rather than opening a client.</SourceRootContractOptOut>
    <!-- Enables the trim, single-file, and AOT analyzers. With TreatWarningsAsErrors from
         Directory.Build.props, any AOT-incompatible API use fails the build. -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Railway-oriented programming (ROP) Result pattern for functional error handling</Description>
    <Version>0.7.1</Version>
    <Authors>jamaynor</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/NyssaAI/NyssaAI.Shared/tree/main/NyssaAI.Result</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
