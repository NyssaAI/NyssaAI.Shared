{
  "name": "@nyssa-ai/configuration",
  "version": "0.3.1",
  "description": "Secure, cross-process locked, AES-256-GCM encrypted configuration storage matching NyssaAI.Configuration",
  "type": "module",
  "main": "./dist/ConfigurationClient.js",
  "types": "./dist/ConfigurationClient.d.ts",
  "exports": {
    ".": {
      "import": "./dist/ConfigurationClient.js",
      "types": "./dist/ConfigurationClient.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('./dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:usecase": "vitest run test/useCase",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NyssaAI/NyssaAI.Shared.git",
    "directory": "nyssa-ai-configuration"
  },
  "keywords": [
    "configuration",
    "security",
    "secrets",
    "encryption",
    "aes-gcm",
    "keyring"
  ],
  "author": "NyssaAI",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
