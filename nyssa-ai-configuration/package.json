    "secrets",
    "encryption",
    "aes-gcm",
    "keyring"
  ],
  "author": "NyssaAI",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
