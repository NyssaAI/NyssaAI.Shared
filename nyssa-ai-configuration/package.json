{
  "name": "@nyssa-ai/configuration",
  "version": "0.2.0",
  "description": "Secure, cross-process locked, AES-256-GCM encrypted configuration storage matching NyssaAI.Configuration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:usecase": "vitest run test/useCase",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "configuration",
