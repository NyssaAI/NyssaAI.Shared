<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NyssaAI.Configuration.UseCaseTests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <!-- What SomeApp-cli declares, once: the name the library takes from the entry assembly.
         AssemblyTitle is the standard .NET way to say it, and the reason
         AddNyssaConfiguration() needs no argument. -->
    <AssemblyTitle>SomeApp-cli</AssemblyTitle>
    <!-- Tutorial methods document the workflows; test-only members are not a shipped API. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <ProjectReference Include="../../Nyssa.Configuration/src/Nyssa.Configuration.csproj" />
    <ProjectReference Include="../../Nyssa.Result/src/Nyssa.Result.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- Logging: the tutorials assert the library's own log lines through a recording provider.
         Http: the OAuth tutorials point the library's token-endpoint client at a fake handler
         through the standard IHttpClientFactory seam, never at a real server. -->
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
</Project>
