<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><IsAotCompatible>true</IsAotCompatible><IsPackable>false</IsPackable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <RepositoryGeneratedPath Condition="'$(RepositoryGeneratedPath)' == ''">$(MSBuildProjectDirectory)/obj/generated</RepositoryGeneratedPath>
    <CompilerGeneratedFilesOutputPath>$(RepositoryGeneratedPath)</CompilerGeneratedFilesOutputPath>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Dapper.AOT</InterceptorsNamespaces>
    <DefineConstants Condition="'$(RepositoryNegativeProbe)' == 'true'">$(DefineConstants);REPOSITORY_NEGATIVE_PROBE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../NyssaAI.Repository/src/NyssaAI.Repository.csproj" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Dapper.AOT" />
  </ItemGroup>
</Project>
